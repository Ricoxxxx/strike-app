{
  "name": "strike-app",
  "version": "1.0.6",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "build": {
    "appId": "com.shopstrike.app",
    "productName": "Strike",
    "files": [
      "**/*",
      "!node_modules/electron-builder${/*}",
      "!dist${/*}"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Ricoxxxx",
      "repo": "strike-app"
    }
  }
}
